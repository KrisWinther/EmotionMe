        <item name="themeAccentColor">@color/blue_primary</item>
        <item name="themeBackgroundColor">@color/blue_background</item>
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorAccent">@color/blue_primary</item>
        <item name="colorControlActivated">@color/blue_primary</item>
        <item name="colorSurface">#1E1E1E</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textColor">@color/black</item>
    </style>
