<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBackgroundColor"
    tools:context=".StatisticsActivity">

    <FrameLayout
        android:id="@+id/backgroundContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/themeBackgroundColor"> <!-- Основной градиент -->

        <!-- Пятно 1 -->
        <View
            android:id="@+id/spot1"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="top|end"
            android:background="@drawable/oval_blue_gradient" />

        <!-- Пятно 2 -->
        <View
            android:id="@+id/spot2"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:background="@drawable/oval_orange_gradient" />

        <View
            android:id="@+id/spot3"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/oval_violet_gradient" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/main_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/field_frame_2"
        android:backgroundTint="?attr/themeAccentColor"
        android:paddingTop="27dp"
        tools:ignore="MissingConstraints">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|start"
            android:layout_marginStart="17dp"
            android:text="@string/screen_stats"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnBackCharts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            android:padding="10dp"
            android:src="@drawable/outline_arrow_back_ios_new_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:drawableTint="@color/white" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="77dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:background="@drawable/field_scroll"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinnerMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown"
                    android:gravity="center"
                    android:background="@drawable/field_scroll"
                    android:popupBackground="@drawable/field_scroll"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:textColor="@color/grey"
                    android:layout_margin="10dp"
                    android:text="|"
                    android:textSize="20sp"
                    android:layout_marginBottom="8dp"
                    android:layout_gravity="center" />

                <Spinner
                    android:id="@+id/spinnerYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:spinnerMode="dropdown"
                    android:popupBackground="@drawable/field_scroll"
                    android:background="@drawable/field_scroll"/>
            </LinearLayout>

            <TextView
                android:id="@+id/moodTV"
                android:layout_width="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:background="@drawable/field_light"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/section_mood"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.emotionme.stable.StatsChartView
                android:id="@+id/moodChart"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_margin="10dp"
                android:background="@drawable/field_light"
                android:padding="5dp"
                android:textAlignment="center" />

            <!-- Тренд настроения по офлайн-анализу текста заметок (TextAnalyzer.sentimentScore),
                 в дополнение к ручному выбору mood из спиннера выше -->
            <TextView
                android:id="@+id/sentimentTrendTV"
                android:layout_width="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/field_light"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/text_analyzing"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.emotionme.stable.SentimentLineChartView
                android:id="@+id/sentimentTrendChart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_margin="10dp"
                android:background="@drawable/field_light"
                android:padding="5dp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/locationTV"
                android:layout_width="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/field_light"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/section_place"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.emotionme.stable.StatsChartView
                android:id="@+id/locationChart"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_margin="10dp"
                android:background="@drawable/field_light"
                android:padding="5dp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/weatherTV"
                android:layout_width="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/field_light"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/section_weather"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.emotionme.stable.StatsChartView
                android:id="@+id/weatherChart"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/field_light"
                android:padding="5dp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/calendarTV"
                android:layout_width="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/field_light"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/section_calendar"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.emotionme.stable.MoodCalendarView
                android:id="@+id/moodCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/field_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="?attr/themeAccentColor"
                android:text="@string/save_data"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="20dp"
                app:cornerRadius="15dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>